CK_LATEST_TARGET_DECLARED false
def CourtadeKumar.Spec.LatestPaperTarget : Prop :=
∀ (n : ℕ) (f : CourtadeKumar.Spec.Cube n → Bool) (p : ℝ),
  0 ≤ p →
    p ≤ 1 →
      CourtadeKumar.Spec.mutualInformation f p ≤
          CourtadeKumar.Spec.progressiveBound p (CourtadeKumar.Spec.outputMean f) ∧
        CourtadeKumar.Spec.progressiveBound p (CourtadeKumar.Spec.outputMean f) ≤ 1 - CourtadeKumar.Spec.entropy p
def CourtadeKumar.Spec.ClassicalTarget : Prop :=
∀ (n : ℕ) (f : CourtadeKumar.Spec.Cube n → Bool) (p : ℝ),
  0 ≤ p → p ≤ 1 → CourtadeKumar.Spec.mutualInformation f p ≤ 1 - CourtadeKumar.Spec.entropy p
def CourtadeKumar.Spec.ThreeBitTarget : Prop :=
∀ (ρ σ : ℝ),
  0 < ρ →
    ρ < 1 →
      0 < σ →
        σ ≤ 1 →
          ρ ^ 2 - CourtadeKumar.Spec.divergence ρ <
            (CourtadeKumar.Spec.divergence ρ - CourtadeKumar.Spec.divergence (ρ * σ)) /
                (2 * (1 + (ρ ^ 2 - CourtadeKumar.Spec.divergence ρ) * Real.log 2 / (1 - ρ ^ 2))) +
              2 * (ρ ^ 2 * CourtadeKumar.Spec.divergence σ - CourtadeKumar.Spec.divergence (ρ * σ)) / σ
